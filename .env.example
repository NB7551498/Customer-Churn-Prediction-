# Copy this file to .env and customise for your environment.
# NEVER commit .env to version control — it is already in .gitignore.

# Dashboard → API connection
API_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Model versioning (must match models/model_metadata.json)
MODEL_VERSION=1.0.0

# Optional: basic API key for /predict and /explain (leave blank to disable)
# API_KEY=
